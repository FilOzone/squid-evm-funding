{
  "name": "@filecoin-project/squid-evm-funding",
  "version": "0.2.2",
  "description": "Minimal helpers for acquiring exact EVM token shortfalls through Squid",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.2",
  "main": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "browser:check": "node scripts/clean-dist.mjs && tsc && tsc -p tsconfig.browser.json && node --conditions=browser scripts/check-browser-runtime.mjs && vitest run src/browser.test.ts",
    "prepare": "node scripts/clean-dist.mjs && tsc",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "viem": "^2.48.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilOzone/squid-evm-funding.git"
  },
  "homepage": "https://github.com/FilOzone/squid-evm-funding#readme",
  "bugs": {
    "url": "https://github.com/FilOzone/squid-evm-funding/issues"
  }
}
